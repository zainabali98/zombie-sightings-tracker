<!DOCTYPE html>
<html lang="en">

<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>🧟 Admin</title>
    <link rel="stylesheet" href="/css/admin-panel.css">
</head>

<body>
    <%- include('./partials/navbar') %>


        <div class="admin-layout">

            <aside class="admin-sidebar">

                <nav class="admin-nav">
                    <a href="/" class="homepage">🏠</a>
                    <a href="/users" class="users">👤</a>
                    <a href="/reports" class="reports">📋</a>
                    <a href="/locations" class="zones">📍</a>
                </nav>

            </aside>

            <main class="admin-main">

                <header class="admin-header">

                    <div>
                        <h1>Admin Dashboard</h1>
                        <p>Welcome, <%= user.username %>.</p>
                    </div>

                </header>

                <section class="admin-panel ongoing-combat">

                    <div class="admin-panel-header">
                        <h2>⚔ Ongoing Combat</h2>
                        <span>Active Zones</span>
                    </div>

                    <div class="admin-table-wrapper">

                        <table class="admin-table">

                            <thead>
                                <tr>
                                    <th>Zone</th>
                                    <th>Count</th>
                                    <th>Status</th>
                                    <th>Reports</th>
                                </tr>
                            </thead>

                            <tbody>

                                <% const zoneNames=['Manama', 'Muharraq' , 'Northern' , 'Southern' ] %>

                                    <% for (let zoneName of zoneNames) { %>

                                        <% const zoneData=zoneSightings.find(zone=> zone.zone === zoneName) %>

                                            <tr>
                                                <td><%= zoneName %></td>

                                                <td><%= zoneData.count %></td>

                                                <td>
                                                    <span class="zone-status 
                    <%= zoneData.status === 'High Threat' ? 'danger' : 
                        zoneData.status === 'Minimal Threat' ? 'warning' : 'safe' %>">
                                                        <%= zoneData.status %>
                                                    </span>
                                                </td>


                                                <td>
                                                    <a href="/locations/<%= zoneName %>"
                                                        class="admin-btn admin-btn-secondary">
                                                        View
                                                    </a>
                                                </td>
                                            </tr>

                                            <% } %>

                            </tbody>

                        </table>

                    </div>

                </section>
                <section class="admin-stats">

                    <div class="admin-stat-card">
                        <div class="admin-stat-label">Total Users</div>
                        <div class="admin-stat-value">
                            <%= users.length %>
                        </div>
                    </div>

                    <div class="admin-stat-card">
                        <div class="admin-stat-label">Total Reports</div>
                        <div class="admin-stat-value">
                            <%= sightings.length %>
                        </div>
                    </div>

                    <div class="admin-stat-card">
                        <div class="admin-stat-label">Total Zones</div>
                        <div class="admin-stat-value">
                            <%= zones.length %>
                        </div>
                    </div>

                    <div class="admin-stat-card">
                        <div class="admin-stat-label">Active Threats</div>
                        <div class="admin-stat-value">5</div>
                    </div>

                </section>

            </main>

        </div>

</body>

</html>