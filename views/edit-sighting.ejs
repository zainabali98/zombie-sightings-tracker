<!DOCTYPE html>
<html lang="en">

<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>🧟 Update Report</title>
    <link rel="stylesheet" href="/css/style.css">
</head>

<body class="new-report-page">

    <%- include('./partials/navbar') %>

        <div class="new-report-content">

            <h1 class="new-report-title">Edit the report carefully!</h1>

            <form class="new-report-form" method="post" action="/reports/<%= sighting._id %>?_method=PUT">

                <div class="new-report-main-fields">

                    <label for="location">Zones:</label>
                    <select name="location" id="location">
                        <option value="Manama">Manama</option>
                        <option value="Muharraq">Muharraq</option>
                        <option value="Northern">Northern</option>
                        <option value="Southern">Southern</option>
                    </select>

                    <label for="specificLocation">Specific Location:</label>
                    <input type="text" name="specificLocation" id="specificLocation"
                        value="<%= sighting.specificLocation %>">

                    <label for="dangerLevel">Danger lvl:</label>
                    <select name="dangerLevel" id="dangerLevel">
                        <option value="1">1</option>
                        <option value="2">2</option>
                        <option value="3">3</option>
                        <option value="4">4</option>
                        <option value="5">5</option>
                        <option value="6">6</option>
                        <option value="Unknown">Unknown</option>
                    </select>

                    <label>Zombie Types at sight:</label>

                    <div class="zombie-types">
                        <label class="zombie-checkbox">
                            <input type="checkbox" name="zombieTypes" value="Runner">
                            Runner
                        </label>

                        <label class="zombie-checkbox">
                            <input type="checkbox" name="zombieTypes" value="Stalker">
                            Stalker
                        </label>

                        <label class="zombie-checkbox">
                            <input type="checkbox" name="zombieTypes" value="Clicker">
                            Clicker
                        </label>

                        <label class="zombie-checkbox">
                            <input type="checkbox" name="zombieTypes" value="Shambler">
                            Shambler
                        </label>

                        <label class="zombie-checkbox">
                            <input type="checkbox" name="zombieTypes" value="Bloater">
                            Bloater
                        </label>

                        <label class="zombie-checkbox">
                            <input type="checkbox" name="zombieTypes" value="Rat King">
                            Rat King
                        </label>

                        <label class="zombie-checkbox">
                            <input type="checkbox" name="zombieTypes" value="Unknown">
                            Unknown
                        </label>
                    </div>

                </div>

                <div class="new-report-description">

                    <label for="description">Description:</label>

                    <textarea name="description" id="description" rows="5"
                        placeholder="Describe the sighting in concise words..."><%= sighting.description %></textarea>

                </div>

                <div class="new-report-buttons">

                    <% if(user && sighting.reportOwner.equals(user._id)){ %>
                        <button type="submit">Update Report</button>
                        <% } %>

                </div>

            </form>

        </div>

</body>

</html>