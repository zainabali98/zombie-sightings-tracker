<!DOCTYPE html>
<html lang="en">

<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>🧟 My Reports</title>
    <link rel="stylesheet" href="/css/style.css">
</head>

<body class="all-reports-page">

    <%- include('./partials/navbar') %>

    <main class="all-reports-container">

        <h1 class="all-reports-title">My Reports</h1>

        <div class="reports-list">

            <% for(let oneSighting of sightings){ %>

                <div class="report-card">

                    <div class="report-card-info">
                        <span class="report-card-label">Location</span>
                        <span class="report-card-location">
                            <%= oneSighting.location %>
                        </span>

                        <span class="report-card-label">Zombie Type</span>
                        <span class="report-card-location">
                            <%= oneSighting.zombieTypes %>
                        </span>
                    </div>

                    <a class="report-details-button"
                        href="/reports/<%= oneSighting._id %>">
                        Report Details
                    </a>

                </div>

            <% } %>

        </div>

    </main>

</body>

</html>