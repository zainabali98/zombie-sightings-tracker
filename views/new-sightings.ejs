<!DOCTYPE html>
<html lang="en">

<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>🧟 New Report</title>
    <link rel="stylesheet" href="/css/style.css">
</head>

<body class="new-report-page">
    <%- include('./partials/navbar') %>

        <div class="new-report-content">
            <h1 class="new-report-title">Report a sighting</h1>

            <form class="new-report-form" method="post" action="/reports">

                <div class="new-report-main-fields">
                    <label for="location">Zones:</label>
                    <select name="location" id="location">
                        <option value="Manama">Manama</option>
                        <option value="Muharraq">Muharraq</option>
                        <option value="Northern">Northern</option>
                        <option value="Southern">Southern</option>
                    </select>

                    <label for="status">Status:</label>
                    <select name="status" id="status">
                        <option value="Cleared/Safe">Cleared/Safe</option>
                        <option value="Overrun">Overrun</option>
                        <option value="Under Evaluation">Under Evaluation</option>
                        <option value="Combat Ongoing">Combat Ongoing</option>
                        <option value="Unknown">Unknown</option>
                    </select>
                    <label for="dangerLevel">Danger lvl:</label>
                    <select name="dangerLevel" id="dangerLevel">
                        <option value="1">1</option>
                        <option value="2">2</option>
                        <option value="3">3</option>
                        <option value="4">4</option>
                        <option value="5">5</option>
                        <option value="6">6</option>
                        <option value="Unknow">Unknown</option>

                    </select>

                    <label>Zombie Types at sight:</label>

                    <div class="zombie-types">
                        <label class="zombie-checkbox">
                            <input type="checkbox" name="zombieTypes" value="Runner">
                            Runner
                        </label>

                        <label class="zombie-checkbox">
                            <input type="checkbox" name="zombieTypes" value="Stalker">
                            Stalker
                        </label>

                        <label class="zombie-checkbox">
                            <input type="checkbox" name="zombieTypes" value="Clicker">
                            Clicker
                        </label>

                        <label class="zombie-checkbox">
                            <input type="checkbox" name="zombieTypes" value="Shambler">
                            Shambler
                        </label>

                        <label class="zombie-checkbox">
                            <input type="checkbox" name="zombieTypes" value="Bloater">
                            Bloater
                        </label>

                        <label class="zombie-checkbox">
                            <input type="checkbox" name="zombieTypes" value="Rat King">
                            Rat King
                        </label>

                        <label class="zombie-checkbox">
                            <input type="checkbox" name="zombieTypes" value="Unknown">
                            Unknown
                        </label>
                    </div>
                </div>
                <div class="new-report-description">
                    <label for="description">Description:</label>
                    <textarea name="description" id="description" rows="5"
                        placeholder="Describe the sighting in concise words..."></textarea>
                </div>
                <div class="new-report-buttons">
<button type="submit">Submit</button>                </div>
            </form>
        </div>

</body>

</html>