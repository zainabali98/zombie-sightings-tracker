<!DOCTYPE html>
<html lang="en">

<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>🧟 New Report</title>
    <link rel="stylesheet" href="/css/style.css">
</head>

<body class="new-report-page">
    <%- include('./partials/navbar') %>

        <div class="new-report-content">
            <h1 class="new-report-title">Report a sighting</h1>

            <form class="new-report-form" method="post" action="/reports">

                <div class="new-report-main-fields">
                    <label for="location">Location:</label>
                    <select name="location" id="location">
                        <option value="Manama">Manama</option>
                        <option value="Muharraq">Muharraq</option>
                        <option value="Riffa">Riffa</option>
                        <option value="Hamad Town">Hamad Town</option>
                    </select>

                    <label for="status">Status:</label>
                    <select name="status" id="status">
                        <option value="Cleared/Safe">Cleared/Safe</option>
                        <option value="Overrun">Overrun</option>
                        <option value="Under Evaluation">Under Evaluation</option>
                        <option value="Combat Ongoing">Combat Ongoing</option>
                        <option value="Unknown">Unknown</option>
                    </select>
                    <label for="dangerLevel">Danger lvl:</label>
                    <select name="dangerLevel" id="dangerLevel">
                        <option value="1">1</option>
                        <option value="2">2</option>
                        <option value="3">3</option>
                        <option value="4">4</option>
                        <option value="5">5</option>
                        <option value="6">6</option>
                        <option value="Unknow">Unknown</option>

                    </select>

                    <label for="zombieTypes">Zombie Types at sight:</label>
                    <select name="zombieTypes" id="zombieTypes">
                        <option value="Runner">Runner</option>
                        <option value="Stalker">Stalker</option>
                        <option value="Clicker">Clicker</option>
                        <option value="Shambler">Shamblers</option>
                        <option value="Bloater">Bloater</option>
                        <option value="Rat King">Rat King</option>
                        <option value="Unknown">Unknown</option>

                    </select>
                </div>
                <div class="new-report-description">
                    <label for="description">Description:</label>
                    <textarea name="description" id="description" rows="5"
                        placeholder="Describe the sighting..."></textarea>
                </div>
                <div class="new-report-buttons">
                    <button name="submit">Submit</button>
                </div>
            </form>
        </div>

</body>

</html>